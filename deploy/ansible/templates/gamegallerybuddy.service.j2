[Unit]
Description=GameGalleryBuddy (Spring Boot, containerized)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User={{ app_user }}
WorkingDirectory={{ app_dir }}
ExecStartPre=-/usr/bin/docker rm -f gamegallerybuddy
ExecStart=/usr/bin/docker run --name gamegallerybuddy --rm \
  -p 127.0.0.1:{{ app_internal_port }}:8080 \
  --env-file {{ app_dir }}/.env \
  gamegallerybuddy:latest
ExecStop=-/usr/bin/docker stop gamegallerybuddy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
